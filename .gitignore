# ============================================================
# Branch workflow
# ============================================================
# main   = ym   (本地开发, origin/main)
# public = Mbmx (对外发布, origin/public → origin-public/main)
#
# 工作流: main 开发 → cherry-pick 到 public → 双推
#   git checkout public
#   git checkout main -- <files>               # 或 git cherry-pick <commit>
#   git commit --author="Mbmx <mbmx@example.com>" -m "..."
#   git push origin public && git push origin-public public:main
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Virtual Environment
venv/
.venv/
env/
conda_*/

# Conda
.conda/

# YOLOv5 Training outputs
yolov5-7.0/runs/

# Model weights (training outputs, regeneratable)
runs/**/*.pt

# But keep pretrained base weights
!yolov5-7.0/yolov5n.pt

# IDE
.idea/

# OS
.DS_Store
Thumbs.db

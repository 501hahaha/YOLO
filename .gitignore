# ============================================================
# Public release identity
# ============================================================
# Public release commits use the publisher name Mbmx.
#   git commit --author="Mbmx <mbmx@example.com>" -m "..."
# Keep local remotes and private machine settings out of the public tree.
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Virtual Environment
venv/
.venv/
env/
conda_*/

# Conda
.conda/

#datasets
ball_image/

# YOLOv5 Training outputs
yolov5-7.0/runs/

# Model weights (training outputs, regeneratable)
runs/**/*.pt

# But keep pretrained base weights
!yolov5-7.0/yolov5n.pt

# IDE
.idea/

# Installers (too large for Git, download separately)
*.exe
*.msi

# OS
.DS_Store
Thumbs.db
